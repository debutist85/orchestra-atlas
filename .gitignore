# Logs
logs
*.log
npm-debug.log*

node_modules
dist
*.local

# Local env config (VITE_MEDIA_URL etc.); .env.example stays tracked.
.env
.env.local

# Local recording stems (large binaries; not committed).
# Covers master WAV, whole-file Opus, stem chunks, and activity
# profiles under public/audio/.
public/*/audio/**
!public/*/audio/**/
!public/*/audio/**/.gitkeep
public/audio/**
!public/audio/**/
!public/audio/**/.gitkeep

# Local-only MusicXML score fixture under public/<excerpt-id>/score/.
public/*/score/**
!public/*/score/.gitkeep

# Generated activity left at the previous public/<excerpt-id>/activity/ location.
public/*/activity/**
!public/*/activity/.gitkeep

# Local instrument artwork (large binaries; not committed).
public/images/**
!public/images/**/
!public/images/**/.gitkeep

# Local atmosphere footage (large binaries; not committed).
public/videos/**
!public/videos/**/
!public/videos/**/.gitkeep

# Editor files
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
