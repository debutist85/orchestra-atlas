# Copy this file to .env.local and set the public R2 bucket URL or custom domain.
# Use the base whose root contains audio/, images/, videos/, and 3d/.
# Example: VITE_MEDIA_URL=https://pub-<bucket-id>.r2.dev
# This value is public browser configuration; never put R2 credentials here.
# Restart npm run dev after changing it. Empty means local public/ assets.
VITE_MEDIA_URL=
