VITE_MEDIA_URL=
# Optional instrument-pack base URL: use <VITE_MEDIA_URL>/3d for R2,
# or /3d/instrument-pack-staging for local exports. Flute stays on its old model.
# If omitted, defaults to <VITE_MEDIA_URL>/3d (or local /3d without a CDN).
# An explicitly empty value selects the previous catalogue models.
# VITE_INSTRUMENT_PACK_URL=/3d/instrument-pack-staging
